# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role (⚠️ Server-side only - NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# API Tokens (Pattern: $token = config('service.api.token'))
# Public API Token (accessible côté client)
NEXT_PUBLIC_API_TOKEN=your_public_api_token_here

# Secret API Token (⚠️ Server-side only - NEVER expose to client)
API_SECRET_TOKEN=your_secret_api_token_here

# Optional: Vercel Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your_analytics_id
